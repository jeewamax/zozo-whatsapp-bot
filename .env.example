# Set these in the hosting provider's secret/environment settings. Do not post them in chat.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Copy a supported version from your Meta dashboard, including its v prefix.
GRAPH_API_VERSION=
# A real staffed support phone/email/link, with availability hours if applicable.
SUPPORT_CONTACT=
PORT=8080
# Use persistent storage for the queue; only one application instance is supported.
BOT_DB=./data/messages.sqlite3
